@{
ViewData["Title"] = "Sign up";
Layout = "_Layout";
}

<head>
    <link rel="stylesheet" href="~/css/auth.css">
</head>

<div class="Container">
    <div class="mainSection">
        <div class="navbar">
            <div class="NavElements">
                <a id="Logo" asp-action="index" asp-controller="Home" ><img src="~/Images/Logo.png"></a>
                <section class="Register">
                    <a asp-action="login" asp-controller="Home" id="Login">Log in</a>
                    <a asp-action="signup" asp-controller="Home" id="Signup">Signup</a>
                </section>
            </div>
        </div>

        <div class="authContainer">
            <div class="authBox">
                <h1>Create Account</h1>
                <p class="subtitle">Join us to explore thousands of books</p>
                    
                <form id="signupForm">
                    <div class="inputGroup">
                        <label for="fullname">Full Name</label>
                        <input type="text" id="fullname" placeholder="Enter your full name" required>
                    </div>
                        
                    <div class="inputGroup">
                        <label for="email">Email</label>
                        <input type="email" id="email" placeholder="Enter your email" required>
                    </div>
                        
                    <div class="inputGroup">
                        <label for="password">Password</label>
                        <input type="password" id="password" placeholder="Create a password" required>
                    </div>
                        
                    <div class="inputGroup">
                        <label for="confirmPassword">Confirm Password</label>
                        <input type="password" id="confirmPassword" placeholder="Confirm your password" required>
                    </div>
                        
                    <div class="termsCheck">
                        <label class="checkbox">
                            <input type="checkbox" id="terms" required>
                            <span>I agree to the <a href="#">Terms & Conditions</a></span>
                        </label>
                    </div>
                        
                    <button type="submit" class="authButton">Sign Up</button>
                        
                    <p class="switchAuth">
                        Already have an account? <a href="login.html">Login here</a>
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/js/auth.js"></script>