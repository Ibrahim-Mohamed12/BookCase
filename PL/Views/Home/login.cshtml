@model LoginUserViewModel;

@{
ViewData["Title"] = "Login";
Layout = "_Layout";
}

<head>
    <link rel="stylesheet" href="~/css/auth.css">
</head>

<div class="Container">
    <div class="mainSection">
        <div class="navbar">
            <div class="NavElements">
                <a id="Logo" asp-action="index" asp-controller="Home"><img src="~/Images/Logo.png"></a>
                <section class="Register">
                    <a asp-action="login" asp-controller="Home" id="Login">Log in</a>
                    <a asp-action="signup" asp-controller="Home" id="Signup">Signup</a>
                </section>
            </div>
        </div>

        <div class="authContainer">
            <div class="authBox">
                <h1>Welcome Back</h1>
                <p class="subtitle">Login to access your favorite books</p>


                <form id="loginForm" asp-action="login" asp-controller="Home" method="post">

                    <div asp-validation-summary="All" style="color: red; background-color: white;"></div>

                    <div class="inputGroup">
                        <label for="email">Email</label>
                        <input asp-for="Email" type="email" id="email" placeholder="Enter your email" required>
                    </div>
                        
                    <div class="inputGroup">
                        <label for="password">Password</label>
                        <input asp-for="Password" type="password" id="password" placeholder="Enter your password" required>
                    </div>

                    <button type="submit" class="authButton">Login</button>
                        
                    <p class="switchAuth">
                        Don't have an account? <a href="signup.html">Sign up here</a>
                    </p>
                </form>
            </div>
        </div>
    </div>