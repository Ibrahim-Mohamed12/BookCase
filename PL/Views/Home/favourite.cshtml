                    </div>
                </div>

                <!-- Article Categories -->
                <div class="CategoriesSection">
                    <div class="Types">
                        <a asp-action="categories" asp-controller="Home" asp-route-id="8BF04F1A-AA47-4740-80B9-81D2526B273A">Comics & Graphic Novels</a>
                        <a asp-action="categories" asp-controller="Home" asp-route-id="85720581-7D73-4EF8-AE52-621A96B6AA30">Technology</a>
                        <a asp-action="categories" asp-controller="Home" asp-route-id="7A365201-511A-4005-A45F-1CE3A40CCEF3">Sports</a>
                        <a asp-action="categories" asp-controller="Home" asp-route-id="736990FC-BF11-4BC7-8BD1-8D34885173ED">Health & Fitness</a>
                        <a asp-action="categories" asp-controller="Home" asp-route-id="6DADAB1A-C0A7-4B25-97F8-319FBE7E2BBC">Hobbies & Crafts</a>
                    </div>
                </div>

                <!-- Article Categories -->
                <div class="CategoriesSection">
                    <div class="Types">
                        <a asp-action="categories" asp-controller="Home" asp-route-id="E278B9AF-7E71-4073-AA72-8D2E5CA1881B">Cooking</a>
                        <a asp-action="categories" asp-controller="Home" asp-route-id="A2312DD3-67C0-4E42-83E8-151391B47CFA">Poetry</a>
                        <a asp-action="categories" asp-controller="Home" asp-route-id="A758299F-420D-4EBF-BCBA-5243DC7535FB">Philosophy</a>
                        <a asp-action="categories" asp-controller="Home" asp-route-id="B0E19EFE-3E6B-48E4-9A2B-7533738FEEC2">Travel</a>
                        <a asp-action="categories" asp-controller="Home" asp-route-id="D31B8866-053D-486F-A622-D41A163A8E8F">Art & Design</a>
                    </div>
                </div>
            </div>
        </div>

        <div id="ImageText">
            <div id="Logo-Text">
                <img src="~/Images/Logo.png">
                <p>Your Personal Library</p>
            </div>
            <div class="scroll-down">
                <i class="arrow"></i>
            </div>
        </div>
    </div>

    <div class="contentContainer">
        <div class="NewHeader">

            <div class="favouriteHeader">
                <h2>My Favourite Lists</h2>
                <p class="quote">"Books are a uniquely portable magic." — Stephen King</p>
            </div>

            <a asp-action="AddFavList" asp-controller="Home"><span class="material-symbols-outlined">Add</span></a>
        </div>

        <div class="BooksContainer">
            <div class="book-collections">

                @foreach (var favlist in ViewBag.favlists)
                {
                    
                    <div class="book-card">

                        <!-- Add preview and favorite icons overlay -->
                        <div class="book-actions">
                            <a class="material-symbols-outlined preview-icon" asp-action="FavBooks" asp-controller="Home" asp-route-id=@favlist.FavID>visibility</a>
                        </div>

                        <img src="~/Images/images.png" alt="The Uses of Libraries Book Cover">
                        <p class="Title">@favlist.FavName</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Add preview popup modal -->
    <div id="previewModal" class="modal">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <div class="modal-body">
                <img id="modalBookImage" src="/placeholder.jpg" alt="Book Cover">
                <div class="modal-details">
                    <h2 id="modalBookTitle"></h2>
                    <p class="modal-author" id="modalBookAuthor"></p>
                    <p class="modal-tags" id="modalBookTags"></p>
                    <p class="modal-description">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
                    <div class="modal-buttons">
                        <button class="btn-display">Display</button>
                        <button class="btn-download">Download</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <footer class="Footer">
        <img src=~/Images/Logo.png" alt="Company Logo" />

        <div class="Links">

            <section>
                <h2>Contact Us</h2>
                <address>
                    123 Main Street, City, Country<br />
                    Phone: <a href="tel:+1234567890">+1 234 567 890</a><br />
                    Email: <a href="mailto:info@company.com">info@company.com</a>
                </address>
            </section>

            <section>
                <h2>Follow Us</h2>
                <div class="SocialMedia">
                    <a href="#" class="facebook" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="#" class="linkedin" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                        <i class="fab fa-linkedin-in"></i>
                    </a>
                    <a href="#" class="instagram" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                        <i class="fab fa-instagram"></i>
                    </a>
                </div>
            </section>
        </div>
    </footer>
</div>

<script src="~/js/homePage.js"></script>
<script src="~/js/book-features.js"></script>
<script src="~/js/common.js"></script>

