            </div>
        </div>

        <div id="ImageText">
            <div id="Logo-Text">
                <img src="~/Images/Logo.png">
                <p >More Than Books, It's a Journey</p>
            </div>
        <div class="scroll-down">
            <i class="arrow"></i>
        </div>
        </div>
    </div>

    <div class="contentContainer">
            
            <!-- Display Selected Category -->
        <div class="CategoryDetails">
            <h2 id="category-title">@ViewBag.category.CategoryName</h2>
            <p id="category-content">@ViewBag.category.Description</p>
        </div>

        <div class="SearchContainer">
            <input type="search" placeholder="Search" id="searchbar">
            <button type="submit" ><span class="material-symbols-outlined">Search</span></button>
        </div>

    <div class="BooksContainer">
        <div class="book-collections">

                @foreach (var book in ViewBag.category.books)
                {
                    <div class="book-card">
                        <!-- Add preview and favorite icons overlay -->
                        <div class="book-actions">
                            <span class="material-symbols-outlined preview-icon">visibility</span>
                            <span class="material-symbols-outlined favorite-icon" id="FavIcon">favorite_border</span>
                        </div>
                        <img src="@book.ImageURL" alt="The Uses of Libraries Book Cover">
                        <p hidden class="Desc">@book.Description</p>
                        <p hidden class="filepath">@book.Filepath</p>
                        <p hidden class="BookId">@book.BookID</p>
                        <p class="Title">@book.Title</p>
                        <p class="tags" id="Tags">@ViewBag.category.CategoryName</p>
                        <p class="author">@book.Author</p>
                    </div>
                }
        </div>
    </div>

        <!-- Add preview popup modal -->
        <div id="previewModal1" class="modal">
            <div class="modal-content1">
                <span class="close-modal1">&times;</span>
                <div class="modal-body1">
                    <div class="modal-details1">
                        <form asp-action="AddBookToFavlist" asp-controller="Home" method="post">

                            <input type="hidden" name="BookID" class="selectedBookId" />

                            <select name="FavID" class="list">
                                @foreach (var favlist in ViewBag.favList)
                                {
                                    <option value="@favlist.FavID">@favlist.FavName</option>
                                }
                            </select>

                            <div class="modal-buttons1">
                                <button type="submit" class="btn-select">Select</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <!-- Add preview popup modal -->
        <div id="previewModal" class="modal">
            <div class="modal-content">
                <span class="close-modal">&times;</span>
                <div class="modal-body">
                    <img id="modalBookImage" src="/placeholder.svg" alt="Book Cover">
                    <div class="modal-details">
                        <div>
                            <h2 id="modalBookTitle"></h2>
                            <p class="modal-author" id="modalBookAuthor"></p>
                            <p class="modal-tags" id="modalBookTags"></p>
                            <p hidden id="modalfilepath"></p>
                            <p class="modal-description" id="modalDescription"></p>
                        </div>
                        <div class="modal-buttons">
                            <button class="btn-display">Display</button>
                            <button class="btn-download">Download</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <footer class="Footer">
        <img src=~/Images/Logo.png" alt="Company Logo" />

        <div class="Links">

            <section>
                <h2>Contact Us</h2>
                <address>
                    123 Main Street, City, Country<br />
                    Phone: <a href="tel:+1234567890">+1 234 567 890</a><br />
                    Email: <a href="mailto:info@company.com">info@company.com</a>
                </address>
            </section>

            <section>
                <h2>Follow Us</h2>
                <div class="SocialMedia">
                    <a href="#" class="facebook" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="#" class="linkedin" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                        <i class="fab fa-linkedin-in"></i>
                    </a>
                    <a href="#" class="instagram" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                        <i class="fab fa-instagram"></i>
                    </a>
                </div>
            </section>
        </div>
    </footer>
</div>

<script src="~/js/homePage.js"></script> 
