        <div id="ImageText">
            <div id="Logo-Text">
                <img src="~/Images/Logo.png">
                <p>More Than Books, It's a Journey</p>
            </div>
            <div class="scroll-down">
                <i class="arrow"></i>
            </div>
        </div>
    </div>
    <div class="contentContainer" id="nextSection">
        <div class="content">
            <h2>Welcome To BookCase</h2>
            <h3 class="quote">“A reader lives a thousand lives before he dies.” — George R. R. Martin</h3>
            <div class="Img_Text">
                <div class="textSection1">
                    <p>Explore a vast collection of books that span countless genres, languages, and interests, each waiting to be discovered.</p>
                    <p>Delve into inspiring articles designed to inform, enlighten, and spark lasting curiosity about the world around you.</p>
                </div>
                <img src="~/Images/47e46bb96548d277a125bceb5991a57d.png" alt="">
                <div class="textSection2">
                    <p>Immerse yourself in a diverse library that celebrates storytelling, imagination, and the endless pursuit of knowledge.</p>
                    <p>Unlock an expansive archive of research covering science, technology, and other disciplines that shape our modern world.</p>
                </div>
            </div>
        </div>
    </div>
    <div class="Recommendations">
        <div id="Title">Recommendations</div>
        <h3 class="quote">"Reading gives us someplace to go when we have to stay where we are." — Mason Cooley</h3>
        <div class="book-collections">

            <div class="book-page1 active" id="page-4">

                @{
                    var counter = 0;
                }
                
                @foreach(var book in ViewBag.Books)
                {
                    if(counter == 8)
                    {
                        break;
                    }
                    <!-- Page 1 books -->
                    <div class="book-card">
                        <!-- Add preview and favorite icons overlay -->
                        <div class="book-actions">
                            <span class="material-symbols-outlined preview-icon">visibility</span>
                        </div>
                        <img src="@book.ImageURL" alt="The Uses of Libraries Book Cover">
                        <p hidden class="Desc">@book.Description</p>
                        <p hidden class="filepath">@book.Filepath</p>
                        <p hidden class="BookId">@book.BookID</p>
                        <p class="Title">@book.Title</p>
                        <p class="tags" id="Tags">@book.Category.CategoryName</p>
                        <p class="author">@book.Author</p>
                    </div>
                    counter++;
                }
            </div>
        </div>
    </div>

    <!-- Add preview popup modal -->
    <div id="previewModal" class="modal">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <div class="modal-body">
                <img id="modalBookImage" src="/placeholder.svg" alt="Book Cover">
                <div class="modal-details">
                    <div>
                        <h2 id="modalBookTitle"></h2>
                        <p class="modal-author" id="modalBookAuthor"></p>
                        <p class="modal-tags" id="modalBookTags"></p>
                        <p hidden id="modalfilepath"></p>
                        <p class="modal-description" id="modalDescription"></p>
                    </div>
                    <div class="modal-buttons">
                        <button class="btn-display">Display</button>
                        <button class="btn-download">Download</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<footer class="Footer">
    <img src=~/Images/Logo.png" alt="Company Logo" />

    <div class="Links">

        <section>
            <h2>Contact Us</h2>
            <address>
                123 Main Street, City, Country<br />
                Phone: <a href="tel:+1234567890">+1 234 567 890</a><br />
                Email: <a href="mailto:info@company.com">info@company.com</a>
            </address>
        </section>

        <section>
            <h2>Follow Us</h2>
            <div class="SocialMedia">
                <a href="#" class="facebook" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <a href="#" class="linkedin" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                    <i class="fab fa-linkedin-in"></i>
                </a>
                <a href="#" class="instagram" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                    <i class="fab fa-instagram"></i>
                </a>
            </div>
        </section>
    </div>
</footer>

