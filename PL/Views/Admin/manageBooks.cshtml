@{
    ViewData["Title"] = "Admin Dashboard - BookCase";
    Layout = "_Layout";
}

<head>
    <link rel="stylesheet" href="~/css/homePage.css"> <link rel="stylesheet">
</head>

<div class="admin-container">

    <!-- Mobile Topbar -->
    <div class="top-navbar">
        <div class="logo">
            <img src="~/Images/Logo.png" class="logo-img">
            <span>Admin Dashboard</span>
        </div>
        <span id="menuBtn" class="menu-btn" onclick="toggleSidebar()">☰</span>
    </div>

    <!-- Sidebar -->
    <aside class="sidebar-overlay" id="sidebarOverlay">
        <div class="sidebar-logo">
            <img src="~/Images/Logo.png">
        </div>

        <nav class="sidebar-nav">
            <a asp-action="Admin" asp-controller="Admin">
                <span class="material-symbols-outlined">dashboard</span> Overview
            </a>

            <a asp-action="manageUsers" asp-controller="Admin">
                <span class="material-symbols-outlined">group</span> Manage Users
            </a>

            <a class="active">
                <span class="material-symbols-outlined">library_books</span> Manage Books
            </a>
        </nav>
    </aside>

    <main class="admin-main">
        <header class="admin-header">
            <h1>Admin Dashboard</h1>
            <a asp-action="Addbooks" asp-controller="Admin" class="btn-add">
                <span class="material-symbols-outlined">add</span>Add New Book
            </a>
        </header>

        <section class="admin-section" id="books">
            <div class="section-header">
                <h2 style="color: white;">Book Inventory</h2>
            </div>
            <div class="table-wrapper">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Cover</th>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var book in ViewBag.Books)
                        {   
                            <tr>
                                <td><img src="@book.ImageURL" class="table-img"></td>
                                <td>@book.Title</td>
                                <td>@book.Author</td>
                                <td>@book.Description</td>
                                <td>
                                    <div class="action-group">
                                        <a asp-action="UpdateBooks" asp-controller="Admin" asp-route-id=@book.BookID class="action-btn edit"><span class="material-symbols-outlined">edit</span></a>
                                        <a asp-action="DeleteBooks" asp-controller="Admin" asp-route-id=@book.BookID  class="action-btn delete"><span class="material-symbols-outlined">delete</span></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>

<script src="~/js/Admin.js"></script>