<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BookCase | Admin Dashboard</title>
    <link rel="stylesheet" href="Assets/CSS/homePage.css"> <link rel="stylesheet" href="Assets/CSS/admin.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" />
</head>
<body>
    <div class="admin-container">
        <aside class="sidebar">
            <div class="sidebar-logo">
                <img src="assets/IMG/Logo.png" alt="BookCase Logo">
            </div>
            <nav class="sidebar-nav">
                <a href="#overview" class="active"><span class="material-symbols-outlined">dashboard</span> Overview</a>
                <a href="#users"><span class="material-symbols-outlined">group</span> Manage Users</a>
                <a href="#books"><span class="material-symbols-outlined">library_books</span> Manage Books</a>
                <a href="homePage.html"><span class="material-symbols-outlined">home</span> View Site</a>
            </nav>
            <div class="admin-profile">
                <span class="material-symbols-outlined">account_circle</span>
                <p>Admin Mode</p>
            </div>
        </aside>

        <main class="admin-main">
            <header class="admin-header">
                <h1>Admin Dashboard</h1>
                <button class="btn-download" id="addBookBtn"><span class="material-symbols-outlined">add</span> Add New Book</button>
            </header>

            <section class="stats-grid" id="overview">
                <div class="stat-card">
                    <h3>Total Users</h3>
                    <p class="stat-number">1,240</p>
                </div>
                <div class="stat-card">
                    <h3>Total Books</h3>
                    <p class="stat-number">458</p>
                </div>
                <div class="stat-card">
                    <h3>Downloads</h3>
                    <p class="stat-number">8.2k</p>
                </div>
            </section>

            <section class="admin-section" id="users">
                <div class="section-header">
                    <h2 style="color: white;">Registered Users</h2>
                </div>
                <div class="table-wrapper">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>#101</td>
                                <td>Ahmed_Mohamed</td>
                                <td>ahmed@example.com</td>
                                <td>User</td>
                                <td>
                                    <button class="action-btn delete"><span class="material-symbols-outlined">delete</span></button>
                                </td>
                            </tr>
                            </tbody>
                    </table>
                </div>
            </section>

            <section class="admin-section" id="books">
                <div class="section-header">
                    <h2 style="color: white;">Book Inventory</h2>
                </div>
                <div class="table-wrapper">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Cover</th>
                                <th>Title</th>
                                <th>Author</th>
                                <th>Category</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><img src="assets/IMG/Novel Book Cover Template.jpg" class="table-img"></td>
                                <td>The Uses of Libraries</td>
                                <td>Ahmed Mohamed</td>
                                <td>Medical Studies</td>
                                <td>
                                    <div class="action-group">
                                        <button class="action-btn edit"><span class="material-symbols-outlined">edit</span></button>
                                        <button class="action-btn delete"><span class="material-symbols-outlined">delete</span></button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </section>
        </main>
    </div>

    <div id="bookModal" class="modal">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <div class="modal-body">
                <div class="modal-details">
                    <h2 id="modalTitle">Add New Book</h2>
                    <form id="bookForm" class="admin-form">
                        <input type="text" placeholder="Book Title" required>
                        <input type="text" placeholder="Author Name" required>
                        <select>
                            <option value="">Select Category</option>
                            <option value="Science Fiction">Science Fiction</option>
                            <option value="Medical Studies">Medical Studies</option>
                            <option value="History">History</option>
                        </select>
                        <textarea placeholder="Book Description" rows="4"></textarea>
                        <input type="file" accept="image/*">
                        <button type="submit" class="btn-download">Save Book</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>