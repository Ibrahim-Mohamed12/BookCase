@{
    ViewData["Title"] = "Admin Dashboard - BookCase";
    Layout = "_Layout";
}

<head>
    <link rel="stylesheet" href="~/css/homePage.css"> <link rel="stylesheet">
</head>

<div class="admin-container">

    <!-- Mobile Topbar -->
    <div class="top-navbar">
        <div class="logo">
            <img src="~/Images/Logo.png" class="logo-img">
            <span>Admin Dashboard</span>
        </div>
        <span id="menuBtn" class="menu-btn" onclick="toggleSidebar()">☰</span>
    </div>

    <!-- Sidebar -->
    <aside class="sidebar-overlay" id="sidebarOverlay">
        <div class="sidebar-logo">
            <img src="~/Images/Logo.png">
        </div>

        <nav class="sidebar-nav">
            <a href="#overview" class="active">
                <span class="material-symbols-outlined">dashboard</span> Overview
            </a>

            <a asp-action="manageUsers" asp-controller="Admin">
                <span class="material-symbols-outlined">group</span> Manage Users
            </a>

            <a asp-action="manageBooks" asp-controller="Admin">
                <span class="material-symbols-outlined">library_books</span> Manage Books
            </a>
        </nav>
    </aside>

    <main class="admin-main">
        <header class="admin-header">
            <h1>Admin Dashboard</h1>
            <a asp-action="Addbooks" asp-controller="Admin" class="btn-add">
                <span class="material-symbols-outlined">add</span>Add New Book
            </a>
        </header>

        <section class="stats-grid" id="overview">
            <div class="stat-card">
                <h3>Total Users</h3>
                <p class="stat-number">@ViewBag.NOfUsers</p>
            </div>
            <div class="stat-card">
                <h3>Total Books</h3>
                <p class="stat-number">@ViewBag.NOfBooks</p>
            </div>
            <div class="stat-card">
                <h3>Popular Books</h3>
                <p class="stat-number">@ViewBag.NOfFavBooks</p>
            </div>
        </section>

        <section class="admin-section" id="users">
            <div class="section-header">
                <h2 style="color: white;">Registered Users</h2>
            </div>
            <div class="table-wrapper">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{var c = 1;}

                        @foreach(var user in ViewBag.Users)
                        {
                            if (!user.isAdmin)
                            {
                                <tr>
                                    <td>#@c</td>
                                    <td>@user.Name</td>
                                    <td>@user.Email</td>
                                    <td>User</td>
                                    <td>
                                        <a asp-action="DeleteUser" asp-controller="Admin" asp-route-id=@user.UserID class ="action-btn delete"><span class="material-symbols-outlined">delete</span></a>
                                    </td>
                                </tr>
                                c++;
                            }
                        }
                        </tbody>
                </table>
            </div>
        </section>

        <section class="admin-section" id="books">
            <div class="section-header">
                <h2 style="color: white;">Book Inventory</h2>
            </div>
            <div class="table-wrapper">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Cover</th>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Description</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach(var book in ViewBag.Books)
                        {   
                            <tr>
                                <td><img src="@book.ImageURL" class="table-img"></td>
                                <td>@book.Title</td>
                                <td>@book.Author</td>
                                <td>@book.Description</td>
                                <td>
                                    <div class="action-group">
                                        <a asp-action="UpdateBooks" asp-controller="Admin" asp-route-id=@book.BookID class="action-btn edit"><span class="material-symbols-outlined">edit</span></a>
                                        <a asp-action="DeleteBooks" asp-controller="Admin" asp-route-id=@book.BookID  class="action-btn delete"><span class="material-symbols-outlined">delete</span></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </main>
</div>

<script src="~/js/Admin.js"></script>